{
  "name": "backrooms",
  "version": "1.0.0",
  "description": "Procedural 3D backrooms walking simulator",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "BACKROOMS_TEST_FULL=1 vitest run",
    "test:quick": "vitest run --tags-filter='!sweep'",
    "test:related": "vitest related --run --tags-filter='!sweep'",
    "test:changed": "vitest run --changed --tags-filter='!sweep'",
    "bench": "BENCH=1 vitest run tests/bake/bench.test.ts",
    "map": "node tools/map.ts",
    "bakebench": "node tools/bakebench.ts",
    "qa": "node tools/qa.mjs",
    "play": "node tools/play.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "postprocessing": "^6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/three": "~0.186.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.1"
  }
}
